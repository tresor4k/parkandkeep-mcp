{
  "name": "parkandkeep-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Remote MCP server of the Park & Keep airport parking index: car parks serving European airports, their services and airport-level price aggregates for 3, 7 and 14-day stays.",
  "type": "module",
  "license": "MIT",
  "author": "Park & Keep",
  "homepage": "https://parkandkeep.com/en/data/airport-parking-index",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tresor4k/parkandkeep-mcp.git"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('src/data','dist/data',{recursive:true})\"",
    "start": "node dist/http.js",
    "test": "npm run build && node test/http-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.3"
  },
  "mcpName": "io.github.tresor4k/parkandkeep-mcp"
}
