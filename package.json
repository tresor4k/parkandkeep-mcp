{
  "name": "parkandkeep-mcp",
  "version": "0.2.0",
  "description": "MCP server (local stdio or remote) of the Park & Keep airport parking index: car parks serving European airports, their services and airport-level price aggregates for 3, 7 and 14-day stays.",
  "type": "module",
  "license": "MIT",
  "author": "Park & Keep (https://parkandkeep.com)",
  "homepage": "https://parkandkeep.com/en/data/airport-parking-index",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tresor4k/parkandkeep-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "airport-parking",
    "parking",
    "travel",
    "open-data"
  ],
  "bin": {
    "parkandkeep-mcp": "dist/stdio.js"
  },
  "files": [
    "dist/*.js",
    "dist/data",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('src/data','dist/data',{recursive:true})\"",
    "start": "node dist/http.js",
    "test": "npm run build && node test/http-smoke.mjs && node test/stdio-smoke.mjs",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.3"
  },
  "mcpName": "io.github.tresor4k/parkandkeep-mcp"
}
